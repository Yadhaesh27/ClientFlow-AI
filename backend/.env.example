# Database Connection (SQLite default for local dev, PostgreSQL for production)
DATABASE_URL=sqlite:///./clientflow.db
# DATABASE_URL=postgresql://postgres:password@localhost:5432/clientflow

# JWT Security
JWT_SECRET=super-secret-clientflow-hackathon-key-2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Configuration (Google Gemini API)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend & CORS
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,*

# File Upload Directory
UPLOAD_DIR=./uploads
